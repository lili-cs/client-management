# Server
PORT=3000

# Turso (optional — without this, uses a local SQLite file)
# Setup: turso.tech → create a database → copy the URL and token
#   turso db create client-management
#   turso db show client-management --url
#   turso db tokens create client-management
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# Cloudflare R2 (optional — without this, photos/backups are stored locally)
# Setup: dash.cloudflare.com → R2 Object Storage
#   1. Create a bucket (note the bucket name)
#   2. Go to "Manage R2 API Tokens" → Create API Token (read+write)
#   3. Your Account ID is shown on the R2 overview page (right sidebar)
R2_ACCOUNT_ID=fd2858783bd7412de95f0f9b7cc4ef15
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=client-management
